# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.extensia.com.au

# Waitlist and partner enquiry storage (Supabase). The Vercel Supabase integration
# sets these. The service role key is server-only. Create the tables with the files
# in supabase/migrations/. If unset, sign-ups and enquiries are only logged.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
