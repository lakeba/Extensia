# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.extensia.com.au

# Waitlist storage (Supabase). The Vercel Supabase integration sets these.
# The service role key is server-only. Create the table with
# supabase/migrations/20261011000000_waitlist.sql. If unset, sign-ups are only logged.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: each new waitlist sign-up is also POSTed here (Power Automate HTTP trigger).
# The URL contains a signature, so treat it as a secret: set it in Vercel, never commit it.
WAITLIST_WEBHOOK_URL=
